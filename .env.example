# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Gemini → https://aistudio.google.com/apikey (solo servidor: nunca con prefijo NEXT_PUBLIC_)
GEMINI_API_KEY=your-gemini-api-key
# Id del modelo. Lista los disponibles para tu clave con:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.8-flash
